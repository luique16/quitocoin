# Server — local uses SERVER_PORT, Render injects PORT (config reads PORT first)
SERVER_PORT=8080
# PORT=10000

# PostgreSQL — local: localhost, Docker Compose: postgres, Render: auto via render.yaml fromDatabase
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quitocoin?sslmode=disable

# Redis — local/Docker: localhost:6379 or redis:6379, Render: redis://... auto via render.yaml fromService
REDIS_URL=localhost:6379

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Frontend — set to your API URL (local or Render)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MINING_DIFFICULTY=7
